    },
    "trim": {
      "pattern": "fabrics/braid",
      "palette": "gold-braid"
    }
  },
  "params": {
    "lacing": true,
    "hem": 0,
    "length": "floor - 0.06"
  },
  "use": [
    {
      "use": "clothes/components/bodice",
      "params": {
        "to": "waist + 0.02",
