{
  "name": "Entari",
  "kind": "garment",
  "layer": 2,
  "skirted": true,
  "_about": "the long robe of the Islamic world: the Ottoman entari (fitted to the waist, closed down the front edge to edge -- the strip of trim -- long sleeves, to the ankles, girded with a sash) and the Arab qamis or thawb (a plain shirt-robe of linen or cotton to the ankles: its trim in its own cloth). A woman's opens to a deep V over her chemise (`neckline`, `neckFront`, and `front` where the edge's trim begins)",
  "fabrics": {
    "main": {
      "pattern": "fabrics/stripes",
      "palette": "stripe-madder"
    },
    "trim": {
      "pattern": "fabrics/braid",
      "palette": "gold-braid"
    }
  },
  "params": {
    "length": "ankle - 0.02",
    "sleeves": "wrist",
    "neckline": "round",
    "neckFront": 0.02,
    "front": "collar + 0.03",
    "cuff": 0,
    "hem": 0
  },
  "use": [
    {
      "use": "clothes/components/bodice",
      "params": {
        "to": "waist",
        "neckline": "neckline",
        "neckFront": "neckFront",
        "neckBack": 0.01,
        "neckWidth": 40
      }
    },
    {
      "use": "clothes/components/strip",
      "params": {
        "from": "front",
        "to": "waist",
        "centre": 0,
        "span": 6
      }
    },
    {
      "use": "clothes/components/sleeve",
      "params": {
        "to": "sleeves",
        "cuff": "cuff"
      }
    },
    {
      "use": "clothes/components/skirt",
      "params": {
        "from": "waist",
        "to": "length",
        "flare": 0.2,
        "hem": "hem"
      }
    }
  ]
}