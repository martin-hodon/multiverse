    "naveW": 14.0,
    "aisleW": 12.0,
    "pierT": 1.6,
    "aisleT": 1.6,
    "naveL": "bays * bayLen",
    "bodyW": "naveW + 2 * pierT + 2 * aisleW + 2 * aisleT",
    "_naveW": "the nave's and the aisles' clear widths, between the walls' faces",
    "spring": 9.0,
    "arcadeH": 21.0,
    "clearH": 31.0,
    "_arcadeH": "the heights the furnishing is laid out to (the organ, the gallery)",
