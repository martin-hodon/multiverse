    "detail": 4,
    "bays": 11,
    "bayLen": 7.6,
    "naveW": 14.0,
    "aisleW": 12.0,
    "pierT": 1.6,
    "aisleT": 1.6,
    "naveL": "bays * bayLen",
    "bodyW": "naveW + 2 * pierT + 2 * aisleW + 2 * aisleT",
    "spring": 9.0,
    "arcadeH": 21.0,
    "clearH": 31.0,
    "aisleRise": 4.0,
    "clearSill": 2.2,
    "crown": "spring + (bayLen - pierT) / 2 * 1.7321",
    "aisleTop": "crown + aisleRise + 0.6",
    "naveTop": "clearH + naveW / 2 * 1.7321 + 1.2",
    "aisleWallH": "aisleTop + 1.2",
    "frontH": 55.0,
    "towerW": 14.4,
    "towerH": 45.0,
    "roofPitch": 55,
    "ridge": "(naveW / 2 + pierT + 0.3) * 1.4281",
    "towerBays": 3,
    "_towerBays": "the aisles' last bays at the west end, which the towers stand over: they have no aisle vault or roof of their own",
    "flyerX": "bodyW / 2 + 1.2",
    "flyerSpan": "flyerX - naveW / 2 - pierT",
    "_crown": "the arcade's crown: a pointed (equilateral) head over the gap between two piers",
    "_ridge": "the nave roof's height over its eaves: half its width times tan(roofPitch)",
    "_flyerX": "where a flying buttress's pier stands: 1.2m clear of the aisle wall"
  },
  "base": {
    "height": 0.9,
    "steps": 3,
    "stepOut": 0.6,
    "margin": 4
