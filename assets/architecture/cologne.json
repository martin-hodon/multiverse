{
  "name": "Cologne Cathedral",
  "_about": "COLOGNE CATHEDRAL from the same components as Notre-Dame (the `gothic` generator): the `basilica` nave, 43m to the vault, with wide double aisles, rib-vaulted; flying buttresses down both flanks and round the chevet; the west front under two 16m towers rising to a hundred metres, each crowned by an octagonal stage and an openwork spire to 157m (the `domed-tower`); a spiral stair in each tower up to the terrace the spire stands on.",
  "params": {
    "detail": 4,
    "bays": 11,
    "bayLen": 7.6,
    "naveW": 14.0,
    "aisleW": 12.0,
    "pierT": 1.6,
    "aisleT": 1.6,
    "naveL": "bays * bayLen",
    "bodyW": "naveW + 2 * pierT + 2 * aisleW + 2 * aisleT",
    "_naveW": "the nave's and the aisles' clear widths, between the walls' faces",
    "spring": 9.0,
    "arcadeH": 21.0,
    "clearH": 31.0,
    "_arcadeH": "the heights the furnishing is laid out to (the organ, the gallery)",
    "frontH": 55.0,
    "towerW": 14.4,
    "towerH": 45.0,
    "roofPitch": 55,
    "towerBays": 2,
    "_towerBays": "the aisles' last bays at the west end, which the towers stand over: they have no aisle vault or roof of their own",
    "towerD": "towerBays * bayLen + 3",
    "_towerD": "a tower's depth: over the aisle bays it stands on and the west front's 3m -- its back is the next bay's transverse arch",
    "crossA": 5,
    "_crossA": "the first of the two bays the crossing spans, from the west (the crossing square: two bays by the nave's width)",
    "zCross": "naveL / 2 - (crossA + 1) * bayLen",
    "arm": 3.0,
    "apse": 5,
    "pierR": 0.85,
    "shaft": 0.25,
    "clerSpring": 6.0,
    "flyerStages": 2,
    "_flyerStages": "Notre-Dame's flyers clear both aisles in one leap (rebuilt so in the 1220s); Cologne's in two, from intermediate piers",
    "_clerSpring": "the high vault springs this far over the clerestory sill: Notre-Dame's tall clerestory"
  },
  "base": {
    "height": 0.9,
    "steps": 3,
    "stepOut": 0.6,
    "margin": 4
  },
  "railing": {
    "type": "stone"
  },
  "build": [
    "church",
    "west front",
    "towers",
    "tower stairs",
    "tower parapets",
    "spires",
    "tower pinnacles",
    "west gallery",
    "gallery parapet",
    "seating",
    "altar",
    "organ"
