    "roofPitch": 55,
    "towerBays": 2,
    "_towerBays": "the aisles' last bays at the west end, which the towers stand over: they have no aisle vault or roof of their own",
    "towerD": "towerBays * bayLen + 3",
    "_towerD": "a tower's depth: over the aisle bays it stands on and the west front's 3m -- its back is the next bay's transverse arch",
    "crossA": 5,
    "_crossA": "the first of the two bays the crossing spans, from the west (the crossing square: two bays by the nave's width)",
    "zCross": "naveL / 2 - (crossA + 1) * bayLen",
