{
  "name": "Castle tower",
  "_about": "A SQUARE TOWER OF A HISTORICIST CASTLE, w on a side and H to its head: a door storey (door in face 0, +z), three storeys of paired pointed windows, a top storey that carries a CLOCK on every face by `clock` yes (dial clockR at clockY). Its head by `top`: \"spire\" -- a belfry stage Hb tall with `lights` open lancets (bW) in every face, a GABLE gW by gH on every face with a finial, an octagonal TURRET at every corner (tW across, its shaft tH from tDrop under the belfry, a stone cap tS), the steep four-sided slate SPIRE `rise` tall with a vane's rod `vane`, a LUCARNE (lW) on every face lY up it -- Drachenburg's Hauptturm; or \"battlement\" -- a machicolated course (mOut, mH), crenellations pH high every mStep, and by `watch` yes a square stair turret wS wide rising wH from the deck's back corner -- a keep, Drachenburg's Nordturm. (Round towers: components/cone-turret, components/stage-tower.)",
  "params": {
    "detail": 4,
    "w": 7.8,
    "H": 22.0,
    "t": "max(0.5, w * 0.1)",
    "winW": "w * 0.11",
    "doorW": "w * 0.22",
    "doorH": "H * 0.16",
    "top": "spire",
    "clock": "no",
    "clockR": "w * 0.15",
    "clockY": "H * 0.91",
    "Hb": "w * 0.72",
    "lights": 2,
    "bW": "w * 0.13",
    "gW": "w * 0.62",
    "gH": "w * 0.5",
    "tW": "w * 0.17",
    "tH": "Hb + tDrop + 0.6",
    "tS": "w * 0.36",
    "tDrop": 1.6,
    "rise": "w * 1.75",
    "vane": "w * 0.3",
    "lW": "w * 0.15",
    "lY": "rise * 0.22",
    "mOut": 0.5,
    "mH": 1.0,
    "pH": 1.1,
    "mStep": 1.4,
    "watch": "no",
    "wS": "w * 0.3",
    "wH": 2.6,
    "_top": "spire: belfry, gables, corner turrets and the slate spire; battlement: machicolations and crenellations",
    "_clock": "yes: a dial and hands on every face of the top storey",
    "_lights": "how many open lancets each belfry face has",
    "_watch": "with top battlement: yes raises a square stair turret on the deck's -z, +x corner"
  },
  "build": [
    "shaft",
    "clock",
    "belfry",
    "belfry cornice",
    "gables",
    "gable finials",
    "turrets",
    "spire",
    "lucarnes",
    "lucarne roofs",
    "machicolation",
    "machicolation corbels",
    "battlements",
    "watch",
    "watch battlements"
