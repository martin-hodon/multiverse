    "detail": 4,
    "w": 3.0,
    "d": 1.3,
    "c": "d * 0.8",
    "H": 4.0,
    "t": 0.3,
    "foot": 1.5,
    "winW": "(w - 2 * c) * 0.6",
    "sill": "H * 0.22",
    "spring": "H * 0.75",
    "cap": "flat",
    "capRise": "w * 0.9",
    "parH": 0.9,
    "_c": "how far each slanted face comes in toward the middle (c = d: 45 degrees)",
    "_cap": "helm: a slate helm capRise tall; flat: a parapet parH high round its top"
  },
  "build": [
