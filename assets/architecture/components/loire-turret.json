    "winW": "min(0.75, R * 0.36)",
    "cor": 2.0,
    "corOut": 0.22,
    "corH": 0.6,
    "capR": "R + corOut + 0.12",
    "capRise": "capR * 3.4",
    "capSides": 16,
    "fin": "capRise * 0.2",
    "_cor": "the cul-de-lampe's depth under the foot (hidden in a pier where the turret stands on one)",
    "_h1": "the first belt over the foot (the house's first floor); h2 the second storey"
  },
