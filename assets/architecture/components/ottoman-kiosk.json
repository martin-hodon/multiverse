    "colR": 0.3,
    "nf": 7,
    "ns": 6,
    "beam": 0.5,
    "eave": 2.4,
    "pitch": 16,
    "wB": 3.2,
    "wW": 1.2,
    "wSill": 0.9,
    "wSpr": 3.0,
    "dW": 1.8,
    "dS": 3.0,
    "dX": 3.0,
    "dome": "no",
    "domeR": "min(W, L) * 0.32",
    "_G": "the colonnade's depth: the column axes stand G - 0.5 out from the room's walls"
  },
  "build": [
