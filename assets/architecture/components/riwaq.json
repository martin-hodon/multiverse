        "wSill": "wSill",
        "wSpr": "wSpr",
        "gW": "gW",
        "gS": "gS",
        "dk": "dk",
        "dh": "dh",
        "dt": "dt",
        "cn": "cn",
        "n": "nx + 2",
        "arcL": "(nx + 2) * B + p",
        "ends": 1,
        "back": "bF"
      },
      "at": [
        [
          0,
          0,
          "0 - hz",
          0
        ]
      ],
      "repeat": {
        "count": "sF",
        "step": [
          0,
          0,
          0,
          0
        ]
      },
      "_about": "the row along -z, its corner bays at both ends"
