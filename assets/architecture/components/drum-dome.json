    "buttress cornice": {
      "type": "box", "width": "butW + colR * 0.8 + 0.8", "length": "butD + colR * 2 + 0.7", "height": "entH * 0.38",
      "spiral": {"count": "n", "radius": "R + dt + (butD + colR * 2) / 2 + 0.05", "y": "colH + entH * 0.62"}, "standsOn": ["buttress entablature"],
      "_about": "...its cornice standing out over it, level with the drum's (build it by name)"
    },
    "drum entablature": {
      "type": "ring", "count": "n", "rOuter": "R + dt + 0.5", "rInner": "R + dt - 0.05", "height": "entH", "y": "colH", "turn": 0.5, "solid": true,
      "place": [[0, 0, 0, 0]], "standsOn": ["drum a"],
      "_about": "the entablature round the drum between the spurs, over the windows (build it by name)"
