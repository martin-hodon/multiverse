{
  "name": "Drum and dome",
  "_about": "A DOME ON A DRUM, the crown of a church: a drum of `n` bays with a window in every `every`th, a dome of any profile on it, a lantern standing on the dome where it has narrowed to the lantern's width (`atopR`), and -- asked for by name -- ribs up the dome and a PERISTYLE of columns round the drum (and, by name, the `peristyle deck` from the drum out to them). Place it at the top of whatever carries it (a crossing's pendentives, a church's roof ring); R is the drum's inside radius.",
  "params": {
    "detail": 4,
    "R": 10.0,
    "dt": 1.0,
    "H": 8.0,
    "n": 24,
    "every": 2,
    "winW": 1.6,
    "winSill": 1.5,
    "winH": 3.5,
    "profile": "semicircular",
    "spread": 0.6,
    "rise": 8.0,
    "bulge": 1.2,
    "neck": 0.9,
    "waist": 0.8,
    "lift": 1.0,
    "domeT": 1.0,
    "ribsN": "n",
    "ribW": 0.35,
    "lanternR": "R * 0.2",
    "lanternH": "R * 0.45",
    "colR": "H * 0.045",
    "colH": "H * 0.82",
    "pw": "H * 0.35",
    "colN": "n",
    "entH": "H - colH",
    "attic": "no",
    "atticH": 0,
    "atticWin": 1.4,
    "atticSill": "atticH * 0.28",
    "atticWinH": "atticWin * 1.1",
    "domeR": "R + dt",
    "domePlinth": 0,
    "plinth": "no",
    "tholosN": 12,
    "tholosGlobe": "no",
    "tholosGlobeR": "lanternR * 0.18",
    "_tholosGlobeR": "the tholos's globe (tholosGlobe: yes): its radius -- the Capitol's is about a third of her height across",
    "atticHead": "semicircular",
    "_atticHead": "the attic windows' head (semicircular; flat: the Capitol's). NOTE the dome stands at H + atticH + domePlinth whatever `attic` and `plinth` say: leave atticH and domePlinth 0 when those are not built",
    "winHead": "semicircular",
    "pedA": "triangular",
    "pedB": "segmental",
    "butW": "R * 0.16",
    "butD": "R * 0.12",
    "pairS": "colR * 3.4",
    "pairA": "pairS / 2 / (R + dt + butD)",
    "ribPair": "pairS",
    "_ribPair": "`rib pairs` + `rib pairs 2` (build them by name, instead of `ribs`): DOUBLE ribs, each pair ribPair apart at the dome's foot, rising from a column pair; `attic strips` + `attic strips 2`: the paired pilaster strips on the attic over each pair (St Peter's)",
    "lucN": "ribsN",
    "lucR1": 0.97,
    "lucR2": 0.87,
    "lucR3": 0.68,
    "lucW1": "domeR * 0.08",
    "lucW2": "domeR * 0.063",
    "lucW3": "domeR * 0.046",
    "_lucN": "`lucarnes 1..3` + `lucarne roofs 1..3` (build them by name): rows of lucN dormers between the ribs, each row standing on the dome where it has narrowed to domeR * lucRk, lucWk wide (the rows smaller as they climb: St Peter's)",
    "lanternSides": 8,
    "lanternCap": "pointed",
    "lanternCapR": "lanternR * 0.74",
    "lanternDrumH": "lanternH * 0.22",
    "lanternTop": "lanternH + lanternR * 0.09 + lanternDrumH + lanternCapR * 1.732 - lanternR * 0.1",
    "_lanternSides": "`ribbed lantern` + `lantern columns` + `lantern spire` + `lantern ball` + `lantern cross` + `lantern cross arm` (build them by name, instead of `lantern`): a round temple of lanternSides faces with paired columns at its corners, its ribbed cap (lanternCap, lanternCapR), a candelabra spire, the ball and the cross, all standing `atop` the dome where it has narrowed to lanternR; lanternTop is the cap's tip over that point",
    "_winHead": "`drum a` + `drum b` (build them by name, instead of `drum` and `drum piers`): a window in EVERY bay, its head winHead, under a pediment -- pedA over the even bays, pedB over the odd (Michelangelo's drum: triangular and segmental in turn)",
    "_butW": "`buttresses` + `paired columns` + `buttress entablature` (build them by name): a wall spur butW wide standing butD out of the drum between each two bays, a PAIR of columns (colR, colH; pairS apart) half sunk in its face, the entablature breaking forward over them -- St Peter's drum",
    "_domeR": "the dome's own radius (the drum's outside unless said): narrower, it stands back on a `dome plinth` (plinth: yes -- built before the dome, in the default build too) domePlinth high, the ring from the drum's outside in to it -- the Capitol's iron dome on its attic",
    "_tholosN": "`tholos` (build it by name, instead of `lantern`): a round temple of tholosN columns, lanternR to their line and lanternH to its cap (components/tholos) -- the Capitol's, St Peter's",
    "_R": "the drum's inside radius -- a crossing's pendentives' circle; dt its wall, H its height, n its bays (a window every `every`th)",
    "_profile": "the dome's section, any profile (semicircular, pointed + spread, segmental + rise, onion + bulge/neck, bell + waist/lift)",
    "_lanternR": "the lantern: it stands on the dome where the dome has narrowed to its radius",
    "_pw": "the peristyle (build it by name): a ring of columns round the drum, pw out from it, and the deck they carry",
    "_atticH": "the attic (attic: yes): a second windowed storey of the drum over the peristyle's deck, atticH high, the dome on it -- St Isaac's, the Berliner Dom. entH: the peristyle's entablature and deck"
  },
  "build": [
    "drum",
    "drum piers",
    "attic",
    "attic piers",
    "dome plinth",
    "dome",
    "lantern"
  ],
  "parts": {
    "drum": {
      "type": "ring",
      "count": "n",
      "rOuter": "R + dt",
      "rInner": "R",
      "height": "H",
      "turn": 0.5,
      "every": "every",
      "only": "every",
      "opening": {
        "width": "winW",
        "sill": "winSill",
        "springing": "winSill + winH",
        "head": {
          "profile": "semicircular"
        }
      },
      "place": [
        [
          0,
          0,
          0,
          0
        ]
      ],
      "_about": "the drum, a window every `every`th bay..."
    },
    "drum piers": {
      "type": "ring",
      "count": "n",
      "rOuter": "R + dt",
      "rInner": "R",
      "height": "H",
      "turn": 0.5,
      "every": "every",
      "solid": true,
      "place": [
        [
          0,
          0,
          0,
          0
        ]
      ],
      "_about": "...and the piers between (leave them out when every bay has its window: `every` 1)"
    },
    "peristyle": {
      "type": "colonnade",
      "plan": "round",
      "count": "colN",
      "radius": "R + dt + pw",
      "order": "corinthian",
      "columnR": "colR",
      "height": "colH",
      "taper": 0.86,
      "entablature": {
        "h": "entH",
        "depth": "colR * 2.6"
      },
      "at": [
        [
          0,
          0,
          0,
          0
        ]
      ],
      "_about": "a ring of columns round the drum, carrying a deck -- St Paul's, the Pantheon in Paris (build it by name)"
    },
    "peristyle deck": {
      "type": "ring",
      "count": "n",
      "rOuter": "R + dt + pw",
      "rInner": "R + dt",
      "height": "entH",
      "y": "colH",
      "turn": 0.5,
      "solid": true,
      "place": [
        [
          0,
          0,
          0,
          0
        ]
      ],
      "standsOn": [
        "peristyle"
      ],
      "_about": "the deck over the colonnade, from the drum out to the columns' line (the entablature caps only the columns: no broad ring overhangs them)"
    },
    "attic": {
      "type": "ring",
      "count": "n",
      "rOuter": "R + dt",
      "rInner": "R",
      "height": "atticH",
      "y": "H",
      "turn": 0.5,
      "every": "every",
      "only": "every",
      "opening": {
        "width": "atticWin",
        "sill": "atticSill",
        "springing": "atticSill + atticWinH",
        "head": {
          "profile": "atticHead"
        }
      },
      "place": [
        [
          0,
          0,
          0,
          0
        ]
      ],
      "standsOn": [
        "drum"
      ],
      "_about": "the attic: the drum's second storey over the deck, a small window every `every`th bay...",
      "when": {
        "attic": "yes"
      }
    },
    "attic piers": {
      "type": "ring",
      "count": "n",
      "rOuter": "R + dt",
      "rInner": "R",
      "height": "atticH",
      "y": "H",
      "turn": 0.5,
      "every": "every",
      "solid": true,
      "place": [
        [
          0,
          0,
          0,
          0
        ]
      ],
      "standsOn": [
        "drum"
      ],
      "_about": "...and its piers",
      "when": {
        "attic": "yes"
      }
    },
    "dome plinth": {
      "type": "ring",
      "count": "n",
      "rOuter": "R + dt",
      "rInner": "domeR - domeT",
      "height": "domePlinth",
      "y": "H + atticH",
      "turn": 0.5,
      "solid": true,
      "place": [
        [
          0,
          0,
          0,
          0
        ]
      ],
      "standsOn": [
        "drum"
      ],
      "when": {
        "plinth": "yes"
      },
      "_about": "the ring a narrower dome stands back on, from the drum's outside in to the dome's foot (plinth: yes; listed before the dome, which is raised on it)"
    },
    "dome": {
      "type": "dome",
      "sides": "n",
      "turn": -0.5,
      "radius": "domeR",
      "thickness": "domeT",
      "head": {
        "profile": "profile",
        "spread": "spread",
        "rise": "rise",
        "bulge": "bulge",
        "neck": "neck",
        "waist": "waist",
        "lift": "lift"
      },
      "at": [
        [
          0,
          "H + atticH + domePlinth",
          0,
          0
        ]
      ],
      "standsOn": [
        "drum"
      ],
      "_about": "the dome on it"
    },
    "ribs": {
      "type": "ribs",
      "on": "dome",
      "count": "ribsN",
      "width": "ribW",
      "depth": "ribW * 0.7",
      "standsOn": [
        "dome"
      ],
      "_about": "ribs up the dome, one per bay (build it by name)"
    },
    "lantern": {
      "type": "component",
      "use": "components/domed-tower",
      "params": {
        "sides": 8,
        "R": "lanternR",
        "H": "lanternH",
        "t": "lanternR * 0.15",
        "drumR": "lanternR * 0.7",
        "drumH": "lanternH * 0.25",
        "cap": "bell",
        "capR": "lanternR * 0.8",
        "waist": 0.75,
        "lift": 1.0,
        "kok": "lanternR * 0.1",
        "finial": "lanternH * 0.6",
        "doorH": "lanternH * 0.3",
        "winW": "lanternR * 0.35"
      },
      "build": [
        "tower",
        "drum",
        "cap",
        "finial"
      ],
      "at": [
        [
          0,
          "0 - lanternR * 0.1",
          0,
          0
        ]
      ],
      "atop": "dome",
      "atopR": "lanternR",
      "standsOn": [
        "dome"
      ],
      "_about": "the lantern, standing on the dome where it has narrowed to the lantern's width"
    },
    "tholos": {
      "type": "component",
      "use": "components/tholos",
      "params": {
        "R": "lanternR",
        "H": "lanternH",
        "n": "tholosN",
        "globe": "tholosGlobe",
        "globeR": "tholosGlobeR"
      },
      "at": [
        [
          0,
          "0 - lanternR * 0.1",
          0,
          0
        ]
      ],
      "atop": "dome",
      "atopR": "lanternR * 1.25",
      "standsOn": [
        "dome"
      ],
      "_about": "or a round temple for a lantern, standing where the dome has narrowed to its plinth (build it by name)"
    },
    "drum a": {
      "type": "ring", "count": "n", "rOuter": "R + dt", "rInner": "R", "height": "H", "turn": 0.5, "every": 2, "offset": 0, "only": "every",
      "opening": {"width": "winW", "sill": "winSill", "springing": "winSill + winH", "head": {"profile": "winHead"}, "surround": {"head": "pediment", "pediment": "pedA"}},
      "place": [[0, 0, 0, 0]],
      "_about": "the drum with a window in every bay under alternating pediments: the even bays (build it by name, with `drum b`)"
    },
    "drum b": {
      "type": "ring", "count": "n", "rOuter": "R + dt", "rInner": "R", "height": "H", "turn": 0.5, "every": 2, "offset": 1, "only": "every",
      "opening": {"width": "winW", "sill": "winSill", "springing": "winSill + winH", "head": {"profile": "winHead"}, "surround": {"head": "pediment", "pediment": "pedB"}},
      "place": [[0, 0, 0, 0]],
      "_about": "...and the odd bays"
    },
    "buttresses": {
      "type": "box", "width": "butW", "length": "butD + 0.3", "height": "H",
      "spiral": {"count": "n", "radius": "R + dt + butD / 2 - 0.15"},
