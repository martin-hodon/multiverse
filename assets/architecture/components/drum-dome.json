    },
    "lucarnes 1": {
      "type": "box", "width": "lucW1", "length": "lucW1 * 1.2", "height": "lucW1 * 1.45",
      "spiral": {"count": "lucN", "radius": "domeR * lucR1 - 0.2", "turn": "3.1415927 / lucN"}, "atop": "dome", "atopR": "domeR * lucR1", "standsOn": ["dome"],
      "_about": "the dome's lucarnes, row by row between the ribs (build them by name)"
