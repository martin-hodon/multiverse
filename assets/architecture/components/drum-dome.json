    "paired columns": {
      "type": "colonnade", "plan": "round", "count": "n", "radius": "R + dt + butD + colR * 0.4", "order": "corinthian", "columnR": "colR", "height": "colH", "taper": 0.88,
      "at": [[0, 0, 0, "pairA"], [0, 0, 0, "0 - pairA"]], "standsOn": ["buttresses"],
      "_about": "two columns side by side half sunk in each spur's face (build it by name)"
    },
    "buttress entablature": {
      "type": "box", "width": "butW + colR * 0.8", "length": "butD + colR * 2 + 0.3", "height": "entH * 0.62",
      "spiral": {"count": "n", "radius": "R + dt + (butD + colR * 2) / 2 - 0.15", "y": "colH"}, "standsOn": ["buttresses"],
