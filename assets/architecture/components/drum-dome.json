      "_about": "the paired pilaster strips on the attic over each pair of columns (build it by name, with `attic strips 2`)"
    },
    "attic strips 2": {
      "type": "box", "width": "colR * 1.5", "length": 0.5, "height": "atticH",
      "spiral": {"count": "n", "radius": "R + dt + 0.2", "turn": "0 - pairS / 2 / (R + dt)", "y": "H"}, "standsOn": ["attic piers"]
