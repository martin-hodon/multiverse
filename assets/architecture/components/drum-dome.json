      "type": "box", "width": "lanternR * 0.65", "length": "lanternR * 0.1", "height": "lanternR * 0.1",
      "at": [[0, "lanternTop + lanternR * 1.55", 0, 0]], "atop": "dome", "atopR": "lanternR", "standsOn": ["lantern cross"]
    },
    "interior": {
      "type": "interior",
      "of": [
        "drum",
        "drum piers",
        "drum a"
      ],
      "plan": {
        "sides": "n",
        "radius": "R + dt / 2"
