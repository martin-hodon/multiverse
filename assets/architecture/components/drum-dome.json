    "drum cornice": {
      "type": "ring", "count": "n", "rOuter": "R + dt + 0.9", "rInner": "R + dt", "height": "entH * 0.38", "y": "colH + entH * 0.62", "turn": 0.5, "solid": true,
      "place": [[0, 0, 0, 0]], "standsOn": ["drum entablature"],
