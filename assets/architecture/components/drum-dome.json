    },
    "lucarnes 2": {
      "type": "box", "width": "lucW2", "length": "lucW2 * 1.2", "height": "lucW2 * 1.45",
      "spiral": {"count": "lucN", "radius": "domeR * lucR2 - 0.2", "turn": "3.1415927 / lucN"}, "atop": "dome", "atopR": "domeR * lucR2", "standsOn": ["dome"]
