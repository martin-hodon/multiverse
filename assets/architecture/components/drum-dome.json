    "lantern columns": {
      "type": "colonnade", "plan": "round", "count": "lanternSides", "radius": "lanternR * 1.08", "order": "corinthian", "columnR": "lanternR * 0.065", "height": "lanternH * 0.88",
      "sides": 8, "at": [[0, "0 - lanternR * 0.1", 0, "3.1415927 / lanternSides + 0.075"], [0, "0 - lanternR * 0.1", 0, "3.1415927 / lanternSides - 0.075"]],
