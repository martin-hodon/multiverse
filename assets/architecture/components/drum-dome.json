    },
    "lucarnes 3": {
      "type": "box", "width": "lucW3", "length": "lucW3 * 1.2", "height": "lucW3 * 1.45",
      "spiral": {"count": "lucN", "radius": "domeR * lucR3 - 0.2", "turn": "3.1415927 / lucN"}, "atop": "dome", "atopR": "domeR * lucR3", "standsOn": ["dome"]
    },
    "lucarne roofs 3": {
      "type": "roof", "form": "gable", "width": "lucW3 + 0.3", "length": "lucW3 * 1.2 + 0.2", "pitch": 35, "overhang": 0.1,
      "spiral": {"count": "lucN", "radius": "domeR * lucR3 - 0.2", "turn": "3.1415927 / lucN", "y": "lucW3 * 1.45"}, "atop": "dome", "atopR": "domeR * lucR3", "standsOn": ["lucarnes 3"]
    },
    "ribbed lantern": {
      "type": "component", "use": "components/domed-tower",
      "params": {"sides": "lanternSides", "R": "lanternR", "H": "lanternH", "t": "lanternR * 0.13", "drumR": "lanternR * 0.7", "drumH": "lanternDrumH", "cap": "lanternCap",
                 "capR": "lanternCapR", "kok": "lanternR * 0.09", "finial": "lanternR * 0.13", "winW": "lanternR * 0.28", "doorH": "lanternH * 0.3", "capRibs": "lanternSides"},
      "build": ["tower", "head", "neck", "drum", "cornice", "cap", "cap ribs"],
      "at": [[0, "0 - lanternR * 0.1", 0, 0]], "atop": "dome", "atopR": "lanternR", "standsOn": ["dome"],
      "_about": "a round temple of lanternSides faces for a lantern, its ribbed cap (build it by name, with the lantern's columns, spire, ball and cross)"
