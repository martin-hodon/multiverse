      "faces": {
        "0": [
          {
            "h": "low",
            "openings": {
              "pattern": "doorN",
              "width": "doorW",
              "gap": "doorGap",
              "sill": 0,
              "springing": "doorSpring",
              "head": {
                "profile": "pointed",
                "spread": 1
              }
            },
            "glass": false
          },
          {
            "openings": {
              "pattern": "wins",
              "width": "winW",
              "gap": "winGap",
              "sill": "winSill",
              "springing": "winSpring",
              "head": {
                "profile": "pointed",
