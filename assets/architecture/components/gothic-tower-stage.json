              }
            },
            "glass": false
          },
          {
            "openings": {
              "pattern": "wins",
              "width": "winW",
              "gap": "winGap",
              "sill": "winSill",
              "springing": "winSpring",
              "head": {
                "profile": "pointed",
                "spread": 1
