    "detail": 4,
    "bays": 10,
    "bayLen": 9.5,
    "naveW": 16.4,
    "aisleW": 9.6,
    "pierT": 2.8,
    "aisleT": 2.0,
    "naveL": "bays * bayLen",
    "spring": 13.0,
    "arcadeH": 27.0,
    "clearH": 32.0,
    "aisleRise": 3.5,
    "crown": "spring + (bayLen - pierT) / 2 * 1.7321",
    "aisleTop": "crown + aisleRise + 0.6",
    "naveTop": "clearH + naveW / 2 * 1.7321 + 1.2",
    "innerX": "naveW / 2 + pierT + aisleW",
    "outerX": "innerX + aisleT + aisleW",
    "wallX": "outerX + aisleT",
    "outerSpring": 11.0,
    "outerTop": "outerSpring + aisleW / 2 * 1.7321 + 0.8",
    "outerWallH": "outerTop + 1.2",
    "innerWallH": "aisleTop + 1.8",
    "crossZ": "0 - naveL / 2 + 2 * bayLen",
    "facadeH": 50.0,
    "facadeEave": 30.0,
    "facadePitch": "facadeH - facadeEave",
    "_innerX": "the inner aisles' outer edge: the arcade between the two aisles on each side stands there",
    "_crossZ": "the crossing, two bays from the east end of the nave"
  },
