{
  "name": "Notre-Dame de Paris",
  "_about": "NOTRE-DAME DE PARIS, the Gothic cathedral from components: its nave is the `basilica` definition (pointed arcades, clerestory, aisle walls and rib vaults over nave and aisles -- the vault's arch along a bay a lancet steep enough to meet the crown of the wide one); `flying-buttress`es -- pier, pinnacle, flyer -- at every bay down both flanks and in a ring round the chevet; the west front in three TIERS (three portals, the great rose between lancets, the gallery) under its two flat-topped towers; the transept's ends with their 11m roses; the apse with its half vault and half-cone roof over the ambulatory; and the fl\u00e8che, the `domed-tower` component with a 28m tent; across the west front above the portals, the Gallery of Kings: twenty-eight limestone kings of Judah on their ledge under a canopy.",
  "params": {
    "detail": 4,
    "bays": 9,
    "bayLen": 6.6,
    "naveW": 12.5,
    "aisleW": 10.5,
    "pierT": 1.4,
    "aisleT": 1.4,
    "naveL": "bays * bayLen",
    "bodyW": "naveW + 2 * pierT + 2 * aisleW + 2 * aisleT",
    "spring": 7.0,
    "arcadeH": 18.0,
    "clearH": 26.0,
    "aisleRise": 3.5,
    "clearSill": 2.2,
    "crown": "spring + (bayLen - pierT) / 2 * 1.7321",
    "aisleTop": "crown + aisleRise + 0.6",
    "naveTop": "clearH + naveW / 2 * 1.7321 + 1.2",
    "aisleWallH": "aisleTop + 1.2",
    "frontH": 43.0,
    "towerW": 12.0,
    "towerH": 26.0,
    "roofPitch": 50,
    "ridge": "(naveW / 2 + pierT + 0.3) * 1.1918",
    "towerBays": 2,
    "_towerBays": "the aisles' last bays at the west end, which the towers stand over: they have no aisle vault or roof of their own",
    "flyerX": "bodyW / 2 + 1.2",
    "flyerSpan": "flyerX - naveW / 2 - pierT",
    "_crown": "the arcade's crown: a pointed (equilateral) head over the gap between two piers",
    "_ridge": "the nave roof's height over its eaves: half its width times tan(roofPitch)",
    "_flyerX": "where a flying buttress's pier stands: 1.2m clear of the aisle wall"
  },
  "base": {
